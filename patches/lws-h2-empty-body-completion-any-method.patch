index ba1f6e750..0db79da66 100644
--- a/lib/sansio/http/server/server.c
+++ b/lib/sansio/http/server/server.c
@@ -3432,10 +3432,13 @@ deal_body:
 #endif
 
 	if (wsi->http.content_length_explicitly_zero &&
-	    wsi->http.method_post) {
+	    (wsi->http.method_post || wsi->mux_substream)) {
 
 		/*
-		 * POST with an explicit content-length of zero
+		 * POST with an explicit content-length of zero, or any h2 / h3
+		 * request whose body is empty: a PUT or PATCH stream ended
+		 * with its headers is complete as much as a POST one, and an
+		 * app reading a body without Content-Length waits for this.
